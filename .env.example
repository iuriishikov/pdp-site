# Copy to `.env` on the server. Compose reads it automatically.
# Nothing here is secret — the site has no backend and no credentials.

# The image to run. The CD workflow rewrites this line on every deploy, pinning
# an immutable digest rather than a moving tag.
IMAGE=ghcr.io/iuriishikov/pdp-site:latest

# Address Let's Encrypt registers the certificates against, and mails before
# expiry. Required — Compose refuses to run any command without it.
# Point it somewhere you actually read: pdp-consulting.com has no MX records
# today, so mail to it is discarded.
ACME_EMAIL=info@pdp-consulting.com

# Public origin. Used for canonical URLs, Open Graph tags, robots.txt and the
# sitemap. Must be the real origin or social previews break.
#
# Read at build time as well as run time, so a change here needs a rebuild to
# reach the client bundle; CD passes it as a Docker build argument.
NEXT_PUBLIC_SITE_URL=https://pdp-consulting.com
