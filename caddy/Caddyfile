# Caddy obtains and renews TLS certificates automatically. That needs:
#   - A/AAAA records for both pdp-consulting.com and www.pdp-consulting.com
#     pointing at this host
#   - ports 80 and 443 reachable from the internet
#   - the caddy_data volume persisted across deploys
#
# Behind Cloudflare, set the records to "DNS only" (grey cloud) for the first
# issuance, or set the SSL/TLS mode to Full (strict) — anything lower loops
# redirects against the HTTPS redirect below.
{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static private_ranges
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
		-Server
		-X-Powered-By
	}
}

www.pdp-consulting.com {
	import security_headers
	redir https://pdp-consulting.com{uri} permanent
}

pdp-consulting.com {
	encode zstd gzip

	import security_headers

	# The '>' prefix defers the header until after the upstream has responded,
	# which *replaces* the app's own Cache-Control. Without it Caddy appends,
	# and the response carries two conflicting Cache-Control headers.
	@immutable path /_next/static/* /_next/image*
	header @immutable >Cache-Control "public, max-age=31536000, immutable"

	@wellknown path /favicon.ico /robots.txt /sitemap.xml
	header @wellknown >Cache-Control "public, max-age=3600"

	reverse_proxy web:3000 {
		health_uri /api/health
		health_interval 5s
		health_timeout 3s
		health_status 200

		# While a deploy swaps the app container, hold requests instead of
		# failing them. This is what makes the rollout look seamless.
		lb_try_duration 30s
		lb_try_interval 250ms

		fail_duration 10s

		# Disable response buffering so streamed RSC payloads reach the browser
		# as they are produced.
		flush_interval -1
	}

	log {
		output stdout
		format json
	}
}
