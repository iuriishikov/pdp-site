{
  "name": "pdp-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:standalone": "next build && node scripts/assemble-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:fsd": "steiger ./src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run lint:fsd && pnpm run typecheck && pnpm run test && pnpm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "lottie-react": "3.1.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-fast-marquee": "1.6.5",
    "react-textarea-autosize": "8.5.9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@feature-sliced/steiger-plugin": "0.7.0",
    "@next/eslint-plugin-next": "16.3.2",
    "@playwright/test": "1.62.1",
    "@svgr/webpack": "8.1.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "steiger": "0.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
